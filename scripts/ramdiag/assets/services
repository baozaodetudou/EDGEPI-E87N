#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C PYTHONDONTWRITEBYTECODE=1
umask 077
# The service shell is deliberately supervised by /init.  PID 1 stays alive
# even if sshd exits, so this shell must not require itself to be PID 1.
fail() { echo "RAMDIAG FAIL: $*" >&2; while :; do sleep 60; done; }
assert_no_mmc() {
    for node in /sys/class/block/mmcblk*; do
        [ -e "$node" ] || continue
        fail "unexpected MMC block device: ${node##*/}"
    done
}
assert_no_mmc
mkdir -p /run/ssh /run/sshd
chmod 0755 /run/sshd
echo 'RAMDIAG STAGE generating ephemeral SSH host key'
ssh-keygen -q -t ed25519 -N '' -f /run/ssh/ssh_host_ed25519_key || fail hostkey
sshd_path=$(command -v sshd 2>/dev/null) || fail sshd-not-found
"$sshd_path" -t -f /etc/ssh/sshd_config || fail sshd-config
echo 'RAMDIAG SSH READY: root password is doumao'
while :; do
    assert_no_mmc
    "$sshd_path" -D -e -f /etc/ssh/sshd_config >>/run/ramdiag/sshd.log 2>&1 &
    pid=$!
    wait "$pid" 2>/dev/null || :
    echo 'RAMDIAG SSH exited; retrying in 5 seconds' >&2
    sleep 5
done
