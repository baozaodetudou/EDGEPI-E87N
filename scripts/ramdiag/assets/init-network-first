#!/bin/sh
# PID 1 for the E87N RAM-only network diagnostic.  The FIT DTB disables the
# eMMC controller, and this init never mounts or writes a block device.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin LC_ALL=C PYTHONDONTWRITEBYTECODE=1
umask 077
log_line() {
    echo "$*" >&2
    echo "$*" >>/run/ramdiag/boot.log 2>/dev/null || :
}
fail() { log_line "RAMDIAG FAIL: $*"; while :; do sleep 60; done; }
[ "$$" = 1 ] || exit 1

mounted_type() {
    target=$1
    filesystem=$2
    mount_table=${3:-/proc/mounts}
    # /proc/mounts fields are: source mountpoint filesystem options dump pass.
    # The final read variable consumes the remaining fields, so the second and
    # third variables stay aligned with mountpoint and filesystem type.
    while read -r _ mountpoint mount_type _; do
        [ "$mountpoint" = "$target" ] &&
            [ "$mount_type" = "$filesystem" ] && return 0
    done <"$mount_table"
    return 1
}

read_carrier() {
    carrier_value=0
    IFS= read -r carrier_value <"$1" 2>/dev/null || :
    printf '%s\n' "$carrier_value"
}

mount_or_existing() {
    filesystem=$1
    options=$2
    target=$3
    if mount -t "$filesystem" -o "$options" "$filesystem" "$target"; then
        return 0
    fi
    # CONFIG_DEVTMPFS_MOUNT or an earlier initramfs may already have mounted a
    # pseudo-filesystem.  Accept only the expected type; never accept a
    # block-backed mount as a substitute.
    mounted_type "$target" "$filesystem" || fail "mount $filesystem $target"
}

mount_or_existing proc nosuid,nodev,noexec /proc
mount_or_existing sysfs ro,nosuid,nodev,noexec /sys
mount_or_existing devtmpfs nosuid,noexec,mode=0755 /dev

# The MTK watchdog is already armed before Linux starts PID 1.  Start the
# RAM-only keeper as soon as devtmpfs exists, before any diagnostic assertion
# can enter its failure loop.  The previous ordering waited until after the
# eMMC/DT checks; a bad or stale DTB therefore caused a silent ~31-second
# watchdog reset and looked like a kernel hang.
mkdir -p /run || fail run-directory
mount_or_existing tmpfs nosuid,nodev,noexec,mode=0755,size=64m /run
mkdir -p /run/ramdiag || fail ramdiag-directory
watchdog_loop() {
    attempt=0
    while :; do
        if [ -e /dev/watchdog0 ] || [ -e /dev/watchdog ]; then
            /usr/bin/python3 -I /usr/lib/ramdiag/stop-watchdog.py \
                >>/run/ramdiag/watchdog.log 2>&1 &
            watchdog_pid=$!
            wait "$watchdog_pid"
            status=$?
            # Exit status 0 means the card was disabled or no longer exists;
            # a non-zero status is retried so a transient device/ioctl error
            # cannot leave the board armed and unattended.
            [ "$status" -eq 0 ] && return 0
            log_line "RAMDIAG WATCHDOG keeper exited status=$status; retrying"
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -lt 120 ] || {
            echo 'RAMDIAG WATCHDOG device did not become available' \
                >>/run/ramdiag/watchdog.log
            return 1
        }
        sleep 0.25
    done
}
watchdog_loop &

mkdir -p /dev/pts || fail devpts-directory
mount_or_existing devpts nosuid,noexec,mode=0620,ptmxmode=0666 /dev/pts
[ -e /dev/ptmx ] || ln -s pts/ptmx /dev/ptmx || fail ptmx
mount_or_existing tmpfs nosuid,nodev,noexec,mode=1777,size=32m /tmp
mkdir -p /run/ssh /run/sshd || fail directories
chmod 0755 /run/sshd
exec </dev/console >/dev/console 2>&1

echo 'RAMDIAG STAGE init entered; pseudo-filesystems ready'
assert_no_mmc() {
    for node in /sys/class/block/mmcblk*; do
        [ -e "$node" ] || continue
        fail "unexpected MMC block device: ${node##*/}"
    done
}
child_running() {
    child_pid=$1
    [ -r "/proc/$child_pid/stat" ] || return 1
    read -r _ _ stat_state _ <"/proc/$child_pid/stat" || return 1
    [ "$stat_state" != Z ]
}
assert_no_mmc
status_path=/sys/firmware/devicetree/base/soc/mmc@11230000/status
[ -r "$status_path" ] || fail 'eMMC DT status is unavailable'
[ "$(tr -d '\000' <"$status_path")" = disabled ] || fail 'eMMC DT is not disabled'
hostname e87n-ramdiag

modprobe realtek || echo 'RAMDIAG WARN: realtek PHY module unavailable'
modprobe mtk-2p5ge || echo 'RAMDIAG WARN: mtk-2p5ge PHY module unavailable'
assert_no_mmc
network_iface=
network_node=
attempt=0
while [ -z "$network_iface" ]; do
    for iface in eth0 eth1; do
        [ -d "/sys/class/net/$iface" ] || continue
        ip link set "$iface" up 2>/dev/null || continue
        carrier=$(read_carrier "/sys/class/net/$iface/carrier")
        [ "$carrier" = 1 ] || continue
        node=$(readlink -f "/sys/class/net/$iface/of_node" 2>/dev/null) || continue
        case "$node" in
            */ethernet@15100000/mac@0|*/ethernet@15100000/mac@1)
                network_iface=$iface
                network_node=$node
                break
                ;;
        esac
    done
    [ -n "$network_iface" ] && break
    attempt=$((attempt + 1))
    [ "$attempt" -lt 30 ] || fail 'no linked E87N Ethernet interface (eth0/eth1)'
    sleep 1
done
printf '0\n' >/proc/sys/net/ipv4/ip_forward || fail 'cannot disable forwarding'
ip link set lo up || fail loopback
ip address add 192.168.1.1/24 dev "$network_iface" || fail address
ip link set "$network_iface" up || fail link
assert_no_mmc
echo "RAMDIAG READY: ${network_iface}=192.168.1.1 node=${network_node} eMMC=disabled"

beacon_loop() {
    while :; do
        /usr/bin/python3 -I /usr/lib/ramdiag/beacon.py >>/run/ramdiag/beacon.log 2>&1
        status=$?
        echo "RAMDIAG UDP beacon exited status=$status; restarting" >>/run/ramdiag/beacon.log
        sleep 1
    done
}
beacon_loop &

# Never exec the service shell from PID 1.  An sshd implementation may
# re-exec itself and an old diagnostic did exactly that; when it later exited,
# Linux treated the exit as "Attempted to kill init" and panicked.  Keeping the
# supervisor as PID 1 makes service failures observable and recoverable.
echo 'RAMDIAG SUPERVISOR: PID 1 retained; starting service shell'
/bin/sh /usr/lib/ramdiag/services </dev/console >/dev/console 2>&1 &
service_pid=$!
while :; do
    assert_no_mmc
    if ! child_running "$service_pid"; then
        wait "$service_pid" 2>/dev/null || :
        echo 'RAMDIAG WARN: service shell exited; restarting it' >&2
        /bin/sh /usr/lib/ramdiag/services </dev/console >/dev/console 2>&1 &
        service_pid=$!
    fi
    sleep 5
done
