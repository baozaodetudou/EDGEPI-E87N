From: OpenWrt local build <root@localhost>
Subject: [PATCH] net: phy: mediatek: apply E87N LED mode on flat MT7987 driver

Depends on 752 port for BPI-Router-Linux 6.12.108,
b864732ee285e7868fb0857d69a8ff349e37003e.

Use the baseline LED0 register names, add the missing blink/enable
definitions locally, and apply E87N timing, active-low link indication and
activity only in the MT7987 init callback when mediatek,e87n-led-mode is
present. Program the LEDs before selecting their pinctrl state, and
propagate MDIO errors. MT7988 and boards without the property are unchanged.

Application/API checks do not replace compilation or LED hardware tests.

---
diff --git a/drivers/net/phy/mtk-2p5ge.c b/drivers/net/phy/mtk-2p5ge.c
--- a/drivers/net/phy/mtk-2p5ge.c
+++ b/drivers/net/phy/mtk-2p5ge.c
@@ -11,6 +11,7 @@
 #include <linux/phy.h>
 #include <linux/pm_domain.h>
 #include <linux/pm_runtime.h>
+#include <linux/property.h>
 
 #define MTK_2P5GPHY_ID_MT7987	(0x00339c91)
 #define MT7987_2P5GE_PMB_FW		"mediatek/mt7987/i2p5ge-phy-pmb.bin"
@@ -121,6 +122,17 @@
 #define   MTK_PHY_LED1_ON_FDX				BIT(4)
 #define   MTK_PHY_LED1_ON_HDX				BIT(5)
 #define   MTK_PHY_LED1_POLARITY				BIT(14)
+
+#define MTK_PHY_LED0_ON_ENABLE			BIT(15)
+#define MTK_PHY_LED0_BLINK_CTRL			0x25
+#define MTK_PHY_LED_BLINK_1000TX			BIT(0)
+#define MTK_PHY_LED_BLINK_1000RX			BIT(1)
+#define MTK_PHY_LED_BLINK_100TX			BIT(2)
+#define MTK_PHY_LED_BLINK_100RX			BIT(3)
+#define MTK_PHY_LED_BLINK_10TX			BIT(4)
+#define MTK_PHY_LED_BLINK_10RX			BIT(5)
+#define MTK_PHY_LED_BLINK_2500TX			BIT(10)
+#define MTK_PHY_LED_BLINK_2500RX			BIT(11)
 
 #define MTK_EXT_PAGE_ACCESS				0x1f
 #define MTK_PHY_PAGE_STANDARD				0x0000
@@ -652,6 +664,38 @@
 	return phy_restore_page(phydev, oldpage, ret);
 }
 
+/* LED0 carries both colours on E87N; apply only to its MT7987 PHY. */
+static int mt7987_2p5ge_e87n_led_config(struct phy_device *phydev)
+{
+	int ret;
+
+	if (!device_property_read_bool(&phydev->mdio.dev,
+				       "mediatek,e87n-led-mode"))
+		return 0;
+
+	/* E87N timing: approximately 60 ms, 50 percent duty cycle. */
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x22, 0x0200);
+	if (ret < 0)
+		return ret;
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, 0x23, 0x0400);
+	if (ret < 0)
+		return ret;
+
+	/* LED0 only: link at all supported speeds, active low, no link-down. */
+	ret = phy_write_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED0_ON_CTRL,
+			     MTK_PHY_LED0_ON_ENABLE | MTK_PHY_LED0_ON_LINK10 |
+			     MTK_PHY_LED0_ON_LINK100 | MTK_PHY_LED0_ON_LINK1000 |
+			     MTK_PHY_LED0_ON_LINK2500);
+	if (ret < 0)
+		return ret;
+
+	return phy_write_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED0_BLINK_CTRL,
+			     MTK_PHY_LED_BLINK_1000TX | MTK_PHY_LED_BLINK_1000RX |
+			     MTK_PHY_LED_BLINK_100TX | MTK_PHY_LED_BLINK_100RX |
+			     MTK_PHY_LED_BLINK_10TX | MTK_PHY_LED_BLINK_10RX |
+			     MTK_PHY_LED_BLINK_2500TX | MTK_PHY_LED_BLINK_2500RX);
+}
+
 static int mt7987_2p5ge_phy_config_init(struct phy_device *phydev)
 {
 	struct pinctrl *pinctrl;
@@ -673,6 +717,10 @@
 		return ret;
 	ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED1_ON_CTRL,
 			      MTK_PHY_LED1_ON_FDX | MTK_PHY_LED1_ON_HDX);
+	if (ret < 0)
+		return ret;
+
+	ret = mt7987_2p5ge_e87n_led_config(phydev);
 	if (ret < 0)
 		return ret;
 
