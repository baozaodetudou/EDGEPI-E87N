Subject: [PATCH] PCI: mediatek-gen3: handle empty slots and deferred clocks

Refresh against BPI-Router-Linux
b864732ee285e7868fb0857d69a8ff349e37003e (Linux 6.12.108).

Retain the opt-in mediatek,empty-slot-ok handling on link timeout
and use dev_err_probe() for clock acquisition errors. Match the
baseline LTSSM log argument and parse_port tail without fuzz.
---
--- a/drivers/pci/controller/pcie-mediatek-gen3.c
+++ b/drivers/pci/controller/pcie-mediatek-gen3.c
@@ -431,6 +431,12 @@
 		ltssm_index = PCIE_LTSSM_STATE(val);
 		ltssm_state = ltssm_index >= ARRAY_SIZE(ltssm_str) ?
 			      "Unknown state" : ltssm_str[ltssm_index];
+		if (device_property_read_bool(pcie->dev,
+					      "mediatek,empty-slot-ok")) {
+			dev_info(pcie->dev, "PCIe slot has no endpoint\n");
+			return -ENODEV;
+		}
+
 		dev_err(pcie->dev,
 			"PCIe link down, current LTSSM state: %s (%#x)\n",
 			ltssm_state, val);
@@ -854,8 +860,8 @@
 
 	pcie->num_clks = devm_clk_bulk_get_all(dev, &pcie->clks);
 	if (pcie->num_clks < 0) {
-		dev_err(dev, "failed to get clocks\n");
-		return pcie->num_clks;
+		return dev_err_probe(dev, pcie->num_clks,
+				     "failed to get clocks\n");
 	}
 
 	return 0;
