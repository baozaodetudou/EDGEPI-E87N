+struct mtk_sgmii_resources {
+	struct reset_control *reset;
+	struct clk *clks[3];
+	unsigned int num_clks;
+	unsigned int num_enabled;
+	bool reset_deasserted;
+};
+
+static void mtk_sgmii_release_resources(void *data)
+{
+	struct mtk_sgmii_resources *res = data;
+
+	while (res->num_enabled)
+		clk_disable_unprepare(res->clks[--res->num_enabled]);
+	if (res->reset_deasserted)
+		reset_control_assert(res->reset);
+	while (res->num_clks)
+		clk_put(res->clks[--res->num_clks]);
+	reset_control_put(res->reset);
+}
+
+static int mtk_sgmii_enable_resources(struct mtk_eth *eth,
+				      struct device_node *np)
+{
+	static const char * const names[] = {
+		"sgmii_sel", "sgmii_tx", "sgmii_rx",
+	};
+	struct mtk_sgmii_resources *res;
+	struct clk *clk;
+	int i, ret;
+
+	res = devm_kzalloc(eth->dev, sizeof(*res), GFP_KERNEL);
+	if (!res)
+		return -ENOMEM;
+
+	if (of_property_present(np, "resets")) {
+		res->reset = of_reset_control_get_shared(np, NULL);
+		if (IS_ERR(res->reset))
+			return dev_err_probe(eth->dev, PTR_ERR(res->reset),
+					     "failed to get SGMII reset for %pOF\n", np);
+	}
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		clk = of_clk_get_by_name(np, names[i]);
+		if (IS_ERR(clk)) {
+			ret = dev_err_probe(eth->dev, PTR_ERR(clk),
+					    "failed to get %s clock for %pOF\n",
+					    names[i], np);
+			goto err_release;
+		}
+		res->clks[res->num_clks++] = clk;
+	}
+
+	ret = reset_control_deassert(res->reset);
+	if (ret)
+		goto err_release;
+	res->reset_deasserted = true;
+
+	for (i = 0; i < res->num_clks; i++) {
+		ret = clk_prepare_enable(res->clks[i]);
+		if (ret)
+			goto err_release;
+		res->num_enabled++;
+	}
+
+	/* Keep resources live until all phylinks and PCS instances are gone. */
+	return devm_add_action_or_reset(eth->dev, mtk_sgmii_release_resources, res);
+
+err_release:
+	mtk_sgmii_release_resources(res);
+	return ret;
+}
