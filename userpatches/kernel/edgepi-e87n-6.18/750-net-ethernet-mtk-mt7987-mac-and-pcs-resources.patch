+static bool mtk_gmac23_idle(struct mtk_mac *mac)
+{
+	u32 mac_fsm, gdm_fsm;
+
+	switch (mac->id) {
+	case MTK_GMAC2_ID:
+		gdm_fsm = mtk_r32(mac->hw, MTK_FE_GDM2_FSM);
+		break;
+	case MTK_GMAC3_ID:
+		gdm_fsm = mtk_r32(mac->hw, MTK_FE_GDM3_FSM);
+		break;
+	default:
+		return true;
+	}
+
+	mac_fsm = mtk_r32(mac->hw, MTK_MAC_FSM(mac->id));
+	return (mac_fsm & GENMASK(31, 16)) == 0x01010000 &&
+	       !(gdm_fsm & GENMASK(31, 16));
+}
+
+static u32 mtk_mac_sgmii_mask(struct mtk_mac *mac)
+{
+	/* Do not disconnect the other MT7987 MAC while configuring this PCS. */
+	if (MTK_HAS_CAPS(mac->hw->soc->caps, MTK_XGMAC_V2))
+		return BIT(9 - mac->id);
+
+	return SYSCFG0_SGMII_MASK;
 }
 
