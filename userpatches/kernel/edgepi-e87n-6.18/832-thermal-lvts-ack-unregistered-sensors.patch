Subject: [PATCH] thermal: lvts: ACK IRQ status before updating registered sensors

ACK every observed W1C status bit, including an unregistered or invalid
sensor. Only valid sensors with a thermal zone can call the thermal core,
whose guard dereferences tz. Preserve IRQ_HANDLED when status was consumed
even if no registered zone needed updating. E87N registers only sensor 0.

diff --git a/drivers/thermal/mediatek/lvts_thermal.c b/drivers/thermal/mediatek/lvts_thermal.c
index acbfee6..bf73868 100644
--- a/drivers/thermal/mediatek/lvts_thermal.c
+++ b/drivers/thermal/mediatek/lvts_thermal.c
@@ -520,6 +520,10 @@ static irqreturn_t lvts_ctrl_irq_handler(struct lvts_ctrl *lvts_ctrl)
 	 *                  => 0x0009001F
 	 */
 	value = readl(LVTS_MONINTSTS(lvts_ctrl->base));
+	/* ACK all observed status, including sensors without a thermal zone. */
+	writel(value, LVTS_MONINTSTS(lvts_ctrl->base));
+	if (value)
+		iret = IRQ_HANDLED;
 
 	/*
 	 * Let's figure out which sensors raised the interrupt
@@ -528,9 +532,9 @@ static irqreturn_t lvts_ctrl_irq_handler(struct lvts_ctrl *lvts_ctrl)
 	 * corresponding to the sensor id eg. index=0, mask for
 	 * sensor0.
 	 */
-	for (i = 0; i < ARRAY_SIZE(masks); i++) {
+	lvts_for_each_valid_sensor(i, lvts_ctrl) {
 
-		if (!(value & masks[i]))
+		if (!(value & masks[i]) || !lvts_ctrl->sensors[i].tz)
 			continue;
 
 		thermal_zone_device_update(lvts_ctrl->sensors[i].tz,
@@ -538,11 +542,6 @@ static irqreturn_t lvts_ctrl_irq_handler(struct lvts_ctrl *lvts_ctrl)
 		iret = IRQ_HANDLED;
 	}
 
-	/*
-	 * Write back to clear the interrupt status (W1C)
-	 */
-	writel(value, LVTS_MONINTSTS(lvts_ctrl->base));
-
 	return iret;
 }
 
