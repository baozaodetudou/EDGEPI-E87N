Subject: [PATCH] net: phy: mediatek: port MT7987 firmware support to Linux 6.18

Baseline: official Linux 6.18.51,
f6388029ea9e2c9e807d73827658738ea131faee.

Port the existing E87N 6.12 MT7987 PMB/DSP initialization sequence.
Use CONFIG_MEDIATEK_2P5GE_PHY and mediatek/mtk-2p5ge.c, with the
baseline mtk.h register definitions, page helpers, negotiation,
status and LED callbacks. Keep MT7988 callbacks unchanged.

Preserve checked MMIO mapping, firmware sizes, clock polls and MDIO
operations. Retain a local checked token-ring helper because the
6.18 shared helper returns void. Embed shared LED state first in the
MT7987 private data, followed by cached pinctrl/state and a firmware flag.
Load firmware during probe, before 6.18 reads PHY abilities; config_init
reuses the successful load and configures the MT7987-specific registers.
Acquire the LED pinctrl/state once in probe; config_init only selects
the cached state after LED polarity and optional board settings.

Request and size-check both PMB and DSP before mapping or writing
hardware. Keep independent firmware pointers and release both on
every acquired-resource exit; do not invent a hardware rollback.

Use the existing mediatek/mt7987/i2p5ge-phy-pmb.bin (0x18000) and
i2p5ge-phy-DSPBitTb.bin (0x7000); no new firmware is introduced.
Apply before optional 791. Static checks do not prove hardware boot.

---
diff --git a/drivers/net/phy/mediatek/mtk-2p5ge.c b/drivers/net/phy/mediatek/mtk-2p5ge.c
--- a/drivers/net/phy/mediatek/mtk-2p5ge.c
+++ b/drivers/net/phy/mediatek/mtk-2p5ge.c
@@ -1,13 +1,91 @@
 // SPDX-License-Identifier: GPL-2.0+
 #include <linux/bitfield.h>
 #include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
 #include <linux/module.h>
 #include <linux/of_address.h>
 #include <linux/of_platform.h>
 #include <linux/pinctrl/consumer.h>
 #include <linux/phy.h>
+#include <linux/unaligned.h>
 
 #include "mtk.h"
+
+#define MTK_2P5GPHY_ID_MT7987	(0x00339c91)
+#define MT7987_2P5GE_PMB_FW		"mediatek/mt7987/i2p5ge-phy-pmb.bin"
+#define MT7987_2P5GE_PMB_FW_SIZE	(0x18000)
+#define MT7987_2P5GE_DSPBITTB \
+	"mediatek/mt7987/i2p5ge-phy-DSPBitTb.bin"
+#define MT7987_2P5GE_DSPBITTB_SIZE	(0x7000)
+
+#define MTK_2P5GPHY_PMD_REG_BASE	(0x0f010000)
+#define MTK_2P5GPHY_PMD_REG_LEN		(0x210)
+#define DO_NOT_RESET			(0x28)
+#define   DO_NOT_RESET_XBZ		BIT(0)
+#define   DO_NOT_RESET_PMA		BIT(3)
+#define   DO_NOT_RESET_RX		BIT(5)
+#define FNPLL_PWR_CTRL1			(0x208)
+#define   RG_SPEED_MASK			GENMASK(3, 0)
+#define   RG_SPEED_2500			BIT(3)
+#define   RG_SPEED_100			BIT(0)
+#define FNPLL_PWR_CTRL_STATUS		(0x20c)
+#define   RG_STABLE_MASK		GENMASK(3, 0)
+#define   RG_SPEED_2500_STABLE		BIT(3)
+#define   RG_SPEED_100_STABLE		BIT(0)
+
+#define MTK_2P5GPHY_XBZ_PCS_REG_BASE	(0x0f030000)
+#define MTK_2P5GPHY_XBZ_PCS_REG_LEN	(0x844)
+#define PHY_CTRL_CONFIG			(0x200)
+#define PMU_WP				(0x800)
+#define   WRITE_PROTECT_KEY		(0xCAFEF00D)
+#define PMU_PMA_AUTO_CFG		(0x820)
+#define   POWER_ON_AUTO_MODE		BIT(16)
+#define   PMU_AUTO_MODE_EN		BIT(0)
+#define PMU_PMA_STATUS			(0x840)
+#define   CLK_IS_DISABLED		BIT(3)
+
+#define MTK_2P5GPHY_XBZ_PMA_RX_BASE	(0x0f080000)
+#define MTK_2P5GPHY_XBZ_PMA_RX_LEN	(0x5228)
+#define SMEM_WDAT0			(0x5000)
+#define SMEM_WDAT1			(0x5004)
+#define SMEM_WDAT2			(0x5008)
+#define SMEM_WDAT3			(0x500c)
+#define SMEM_CTRL			(0x5024)
+#define   SMEM_HW_RDATA_ZERO		BIT(24)
+#define SMEM_ADDR_REF_ADDR		(0x502c)
+#define CM_CTRL_P01			(0x5100)
+#define CM_CTRL_P23			(0x5124)
+#define DM_CTRL_P01			(0x5200)
+#define DM_CTRL_P23			(0x5224)
+
+#define MTK_2P5GPHY_CHIP_SCU_BASE	(0x0f0cf800)
+#define MTK_2P5GPHY_CHIP_SCU_LEN	(0x12c)
+#define SYS_SW_RESET			(0x128)
+#define   RESET_RST_CNT			BIT(0)
+
+#define MTK_2P5GPHY_PMB_FW_BASE		(0x0f100000)
+
+#define MTK_2P5GPHY_APB_BASE		(0x11c30000)
+#define MTK_2P5GPHY_APB_LEN		(0x9c)
+#define SW_RESET			(0x94)
+#define   MD32_RESTART_EN_CLEAR		BIT(9)
+
+#define MTK_PHY_LINK_STATUS_RELATED		(0x147)
+#define   MTK_PHY_BYPASS_LINK_STATUS_OK		BIT(4)
+#define   MTK_PHY_FORCE_LINK_STATUS_HCD		BIT(3)
+
+#define MTK_PHY_AN_FORCE_SPEED_REG		(0x313)
+#define   MTK_PHY_MASTER_FORCE_SPEED_SEL_EN	BIT(7)
+#define   MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK	GENMASK(6, 0)
+
+struct mt7987_2p5ge_phy_priv {
+	/* Must be first: the shared LED callbacks use mtk_socphy_priv. */
+	struct mtk_socphy_priv leds;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *led_state;
+	bool fw_loaded;
+};
 
 #define MTK_2P5GPHY_ID_MT7988		0x00339c11
 
@@ -376,7 +454,421 @@
 	return 0;
 }
 
+static int mt7987_2p5ge_phy_load_fw(struct phy_device *phydev)
+{
+	struct mt7987_2p5ge_phy_priv *priv = phydev->priv;
+	struct device *dev = &phydev->mdio.dev;
+	void __iomem *xbz_pcs_reg_base;
+	void __iomem *xbz_pma_rx_base;
+	void __iomem *chip_scu_base;
+	void __iomem *pmd_reg_base;
+	void __iomem *mcu_csr_base;
+	const struct firmware *pmb_fw;
+	const struct firmware *dsp_fw;
+	void __iomem *apb_base;
+	void __iomem *pmb_addr;
+	int ret, i;
+	u32 reg;
+
+	if (priv->fw_loaded)
+		return 0;
+
+	/* Validate both images before mapping or changing any hardware state. */
+	ret = request_firmware_direct(&pmb_fw, MT7987_2P5GE_PMB_FW, dev);
+	if (ret) {
+		dev_err(dev, "failed to load firmware: %s, ret: %d\n",
+			MT7987_2P5GE_PMB_FW, ret);
+		return ret;
+	}
+	if (pmb_fw->size != MT7987_2P5GE_PMB_FW_SIZE) {
+		dev_err(dev, "PMb firmware size 0x%zx != 0x%x\n",
+			pmb_fw->size, MT7987_2P5GE_PMB_FW_SIZE);
+		ret = -EINVAL;
+		goto release_pmb;
+	}
+
+	ret = request_firmware_direct(&dsp_fw, MT7987_2P5GE_DSPBITTB, dev);
+	if (ret) {
+		dev_err(dev, "failed to load firmware: %s, ret: %d\n",
+			MT7987_2P5GE_DSPBITTB, ret);
+		goto release_pmb;
+	}
+	if (dsp_fw->size != MT7987_2P5GE_DSPBITTB_SIZE) {
+		dev_err(dev, "DSPBITTB size 0x%zx != 0x%x\n",
+			dsp_fw->size, MT7987_2P5GE_DSPBITTB_SIZE);
+		ret = -EINVAL;
+		goto release_dsp;
+	}
+
+	apb_base = ioremap(MTK_2P5GPHY_APB_BASE,
+			   MTK_2P5GPHY_APB_LEN);
+	if (!apb_base) {
+		ret = -ENOMEM;
+		goto release_dsp;
+	}
+
+	pmd_reg_base = ioremap(MTK_2P5GPHY_PMD_REG_BASE,
+			       MTK_2P5GPHY_PMD_REG_LEN);
+	if (!pmd_reg_base) {
+		ret = -ENOMEM;
+		goto free_apb;
+	}
+
+	xbz_pcs_reg_base = ioremap(MTK_2P5GPHY_XBZ_PCS_REG_BASE,
+				   MTK_2P5GPHY_XBZ_PCS_REG_LEN);
+	if (!xbz_pcs_reg_base) {
+		ret = -ENOMEM;
+		goto free_pmd;
+	}
+
+	xbz_pma_rx_base = ioremap(MTK_2P5GPHY_XBZ_PMA_RX_BASE,
+				  MTK_2P5GPHY_XBZ_PMA_RX_LEN);
+	if (!xbz_pma_rx_base) {
+		ret = -ENOMEM;
+		goto free_pcs;
+	}
+
+	chip_scu_base = ioremap(MTK_2P5GPHY_CHIP_SCU_BASE,
+				MTK_2P5GPHY_CHIP_SCU_LEN);
+	if (!chip_scu_base) {
+		ret = -ENOMEM;
+		goto free_pma;
+	}
+
+	mcu_csr_base = ioremap(MTK_2P5GPHY_MCU_CSR_BASE,
+			       MTK_2P5GPHY_MCU_CSR_LEN);
+	if (!mcu_csr_base) {
+		ret = -ENOMEM;
+		goto free_chip_scu;
+	}
+
+	pmb_addr = ioremap(MTK_2P5GPHY_PMB_FW_BASE, MT7987_2P5GE_PMB_FW_SIZE);
+	if (!pmb_addr) {
+		ret = -ENOMEM;
+		goto free_mcu_csr;
+	}
+
+	/* Force 2.5Gphy back to AN state */
+	ret = phy_set_bits(phydev, MII_BMCR, BMCR_RESET);
+	if (ret < 0)
+		goto free_pmb_addr;
+	usleep_range(5000, 6000);
+	ret = phy_set_bits(phydev, MII_BMCR, BMCR_PDOWN);
+	if (ret < 0)
+		goto free_pmb_addr;
+
+	reg = readw(apb_base + SW_RESET);
+	writew(reg & ~MD32_RESTART_EN_CLEAR, apb_base + SW_RESET);
+	writew(reg | MD32_RESTART_EN_CLEAR, apb_base + SW_RESET);
+	writew(reg & ~MD32_RESTART_EN_CLEAR, apb_base + SW_RESET);
+
+	reg = readw(mcu_csr_base + MD32_EN_CFG);
+	writew(reg & ~MD32_EN, mcu_csr_base + MD32_EN_CFG);
+
+	for (i = 0; i < MT7987_2P5GE_PMB_FW_SIZE - 1; i += 4)
+		writel(get_unaligned_le32(pmb_fw->data + i), pmb_addr + i);
+	dev_info(dev, "Firmware date code: %x/%x/%x, version: %x.%x\n",
+		 get_unaligned_be16(pmb_fw->data + MT7987_2P5GE_PMB_FW_SIZE - 8),
+		 *(pmb_fw->data + MT7987_2P5GE_PMB_FW_SIZE - 6),
+		 *(pmb_fw->data + MT7987_2P5GE_PMB_FW_SIZE - 5),
+		 *(pmb_fw->data + MT7987_2P5GE_PMB_FW_SIZE - 2),
+		 *(pmb_fw->data + MT7987_2P5GE_PMB_FW_SIZE - 1));
+
+	/* Enable 100Mbps module clock. */
+	writel(FIELD_PREP(RG_SPEED_MASK, RG_SPEED_100),
+	       pmd_reg_base + FNPLL_PWR_CTRL1);
+
+	/* Check if 100Mbps module clock is ready. */
+	ret = readl_poll_timeout(pmd_reg_base + FNPLL_PWR_CTRL_STATUS, reg,
+				 reg & RG_SPEED_100_STABLE, 1, 10000);
+	if (ret) {
+		dev_err(dev, "Fail to enable 100Mbps module clock: %d\n", ret);
+		goto free_pmb_addr;
+	}
+
+	/* Enable 2.5Gbps module clock. */
+	writel(FIELD_PREP(RG_SPEED_MASK, RG_SPEED_2500),
+	       pmd_reg_base + FNPLL_PWR_CTRL1);
+
+	/* Check if 2.5Gbps module clock is ready. */
+	ret = readl_poll_timeout(pmd_reg_base + FNPLL_PWR_CTRL_STATUS, reg,
+				 reg & RG_SPEED_2500_STABLE, 1, 10000);
+
+	if (ret) {
+		dev_err(dev, "Fail to enable 2.5Gbps module clock: %d\n", ret);
+		goto free_pmb_addr;
+	}
+
+	/* Disable AN */
+	ret = phy_clear_bits(phydev, MII_BMCR, BMCR_ANENABLE);
+	if (ret < 0)
+		goto free_pmb_addr;
+
+	/* Force to run at 2.5G speed */
+	ret = phy_modify_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_AN_FORCE_SPEED_REG,
+			     MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK,
+			     MTK_PHY_MASTER_FORCE_SPEED_SEL_EN |
+			     FIELD_PREP(MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK, 0x1b));
+	if (ret < 0)
+		goto free_pmb_addr;
+
+	ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_LINK_STATUS_RELATED,
+			       MTK_PHY_BYPASS_LINK_STATUS_OK |
+			       MTK_PHY_FORCE_LINK_STATUS_HCD);
+	if (ret < 0)
+		goto free_pmb_addr;
+
+	/* Set xbz, pma and rx as "do not reset" in order to input DSP code. */
+	reg = readl(pmd_reg_base + DO_NOT_RESET);
+	reg |= DO_NOT_RESET_XBZ | DO_NOT_RESET_PMA | DO_NOT_RESET_RX;
+	writel(reg, pmd_reg_base + DO_NOT_RESET);
+
+	reg = readl(chip_scu_base + SYS_SW_RESET);
+	writel(reg & ~RESET_RST_CNT, chip_scu_base + SYS_SW_RESET);
+
+	writel(WRITE_PROTECT_KEY, xbz_pcs_reg_base + PMU_WP);
+
+	reg = readl(xbz_pcs_reg_base + PMU_PMA_AUTO_CFG);
+	reg |= PMU_AUTO_MODE_EN | POWER_ON_AUTO_MODE;
+	writel(reg, xbz_pcs_reg_base + PMU_PMA_AUTO_CFG);
+
+	/* Check if clock in auto mode is disabled. */
+	ret = readl_poll_timeout(xbz_pcs_reg_base + PMU_PMA_STATUS, reg,
+				 (reg & CLK_IS_DISABLED) == 0x0, 1, 100000);
+	if (ret) {
+		dev_err(dev, "Clock isn't disabled in auto mode: %d\n", ret);
+		goto free_pmb_addr;
+	}
+
+	reg = readl(xbz_pma_rx_base + SMEM_CTRL);
+	writel(reg | SMEM_HW_RDATA_ZERO, xbz_pma_rx_base + SMEM_CTRL);
+
+	reg = readl(xbz_pcs_reg_base + PHY_CTRL_CONFIG);
+	writel(reg | BIT(16), xbz_pcs_reg_base + PHY_CTRL_CONFIG);
+
+	/* Initialize data memory */
+	reg = readl(xbz_pma_rx_base + DM_CTRL_P01);
+	writel(reg | BIT(28), xbz_pma_rx_base + DM_CTRL_P01);
+	reg = readl(xbz_pma_rx_base + DM_CTRL_P23);
+	writel(reg | BIT(28), xbz_pma_rx_base + DM_CTRL_P23);
+
+	/* Initialize coefficient memory */
+	reg = readl(xbz_pma_rx_base + CM_CTRL_P01);
+	writel(reg | BIT(28), xbz_pma_rx_base + CM_CTRL_P01);
+	reg = readl(xbz_pma_rx_base + CM_CTRL_P23);
+	writel(reg | BIT(28), xbz_pma_rx_base + CM_CTRL_P23);
+
+	/* Initialize PM offset */
+	writel(0, xbz_pma_rx_base + SMEM_ADDR_REF_ADDR);
+
+	for (i = 0; i < dsp_fw->size - 1; i += 16) {
+		writel(get_unaligned_le32(dsp_fw->data + i),
+		       xbz_pma_rx_base + SMEM_WDAT0);
+		writel(get_unaligned_le32(dsp_fw->data + i + 0x4),
+		       xbz_pma_rx_base + SMEM_WDAT1);
+		writel(get_unaligned_le32(dsp_fw->data + i + 0x8),
+		       xbz_pma_rx_base + SMEM_WDAT2);
+		writel(get_unaligned_le32(dsp_fw->data + i + 0xc),
+		       xbz_pma_rx_base + SMEM_WDAT3);
+	}
+
+	reg = readl(xbz_pma_rx_base + DM_CTRL_P01);
+	writel(reg & ~BIT(28), xbz_pma_rx_base + DM_CTRL_P01);
+
+	reg = readl(xbz_pma_rx_base + DM_CTRL_P23);
+	writel(reg & ~BIT(28), xbz_pma_rx_base + DM_CTRL_P23);
+
+	reg = readl(xbz_pma_rx_base + CM_CTRL_P01);
+	writel(reg & ~BIT(28), xbz_pma_rx_base + CM_CTRL_P01);
+
+	reg = readl(xbz_pma_rx_base + CM_CTRL_P23);
+	writel(reg & ~BIT(28), xbz_pma_rx_base + CM_CTRL_P23);
+
+	reg = readw(mcu_csr_base + MD32_EN_CFG);
+	writew(reg | MD32_EN, mcu_csr_base + MD32_EN_CFG);
+	ret = phy_set_bits(phydev, MII_BMCR, BMCR_RESET);
+	if (ret < 0)
+		goto free_pmb_addr;
+	/* We need a delay here to stabilize initialization of MCU */
+	usleep_range(7000, 8000);
+	dev_info(dev, "Firmware loading/trigger ok.\n");
+
+	priv->fw_loaded = true;
+
+free_pmb_addr:
+	iounmap(pmb_addr);
+free_mcu_csr:
+	iounmap(mcu_csr_base);
+free_chip_scu:
+	iounmap(chip_scu_base);
+free_pma:
+	iounmap(xbz_pma_rx_base);
+free_pcs:
+	iounmap(xbz_pcs_reg_base);
+free_pmd:
+	iounmap(pmd_reg_base);
+free_apb:
+	iounmap(apb_base);
+release_dsp:
+	release_firmware(dsp_fw);
+release_pmb:
+	release_firmware(pmb_fw);
+
+	return ret;
+}
+
+/* The shared 6.18 token-ring helper is void; retain MDIO error checks. */
+static int mt7987_2p5ge_tr_modify(struct phy_device *phydev, u8 ch_addr,
+				  u8 node_addr, u8 data_addr, u32 mask, u32 set)
+{
+	u16 tr_cmd = BIT(15) | ((ch_addr & 0x3) << 11) |
+		     ((node_addr & 0xf) << 7) | ((data_addr & 0x3f) << 1);
+	int oldpage, ret, low, high;
+	u32 tr_data;
+
+	oldpage = phy_select_page(phydev, MTK_PHY_PAGE_EXTENDED_52B5);
+	if (oldpage < 0)
+		return phy_restore_page(phydev, oldpage, oldpage);
+
+	ret = __phy_write(phydev, 0x10, tr_cmd | BIT(13));
+	if (ret < 0)
+		goto out;
+	low = __phy_read(phydev, 0x11);
+	if (low < 0) {
+		ret = low;
+		goto out;
+	}
+	high = __phy_read(phydev, 0x12);
+	if (high < 0) {
+		ret = high;
+		goto out;
+	}
+	tr_data = ((u32)high << 16) | low;
+	tr_data = (tr_data & ~mask) | set;
+	ret = __phy_write(phydev, 0x11, tr_data & 0xffff);
+	if (ret < 0)
+		goto out;
+	ret = __phy_write(phydev, 0x12, tr_data >> 16);
+	if (ret < 0)
+		goto out;
+	ret = __phy_write(phydev, 0x10, tr_cmd);
+out:
+	return phy_restore_page(phydev, oldpage, ret);
+}
+
+static int mt7987_2p5ge_phy_config_init(struct phy_device *phydev)
+{
+	struct mt7987_2p5ge_phy_priv *priv = phydev->priv;
+	int ret;
+
+	if (phydev->interface != PHY_INTERFACE_MODE_INTERNAL)
+		return -ENODEV;
+
+	ret = mt7987_2p5ge_phy_load_fw(phydev);
+	if (ret < 0)
+		return ret;
+
+	/* MT7987 uses active-low LEDs; the MT7988 path remains unchanged. */
+	ret = phy_modify_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED0_ON_CTRL,
+			     MTK_PHY_LED_ON_POLARITY,
+			     MTK_PHY_LED_ON_LINK10 | MTK_PHY_LED_ON_LINK100 |
+			     MTK_PHY_LED_ON_LINK1000 | MTK_PHY_LED_ON_LINK2500);
+	if (ret < 0)
+		return ret;
+	ret = phy_set_bits_mmd(phydev, MDIO_MMD_VEND2, MTK_PHY_LED1_ON_CTRL,
+			       MTK_PHY_LED_ON_FDX | MTK_PHY_LED_ON_HDX);
+	if (ret < 0)
+		return ret;
+
+	/* Switch pinctrl after setting polarity to avoid bogus blinking. */
+	if (priv->pinctrl) {
+		ret = pinctrl_select_state(priv->pinctrl, priv->led_state);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = phy_modify_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_LPI_PCS_DSP_CTRL,
+			     MTK_PHY_LPI_SIG_EN_LO_THRESH100_MASK, 0);
+	if (ret < 0)
+		return ret;
+
+	/* Enable 16-bit next page exchange if 1000BASE-T is not advertising. */
+	ret = mt7987_2p5ge_tr_modify(phydev, 0x0, 0xf, 0x3c,
+				     AUTO_NP_10XEN, AUTO_NP_10XEN);
+	if (ret < 0)
+		return ret;
+
+	ret = phy_modify_paged(phydev, MTK_PHY_PAGE_EXTENDED_1,
+			       MTK_PHY_AUX_CTRL_AND_STATUS,
+			       0, MTK_PHY_ENABLE_DOWNSHIFT);
+	if (ret < 0)
+		return ret;
+
+	ret = mt798x_2p5ge_phy_led_hw_control_get(phydev, 0, NULL);
+	if (ret < 0)
+		return ret;
+
+	return mt798x_2p5ge_phy_led_hw_control_get(phydev, 1, NULL);
+}
+
+static int mt7987_2p5ge_phy_probe(struct phy_device *phydev)
+{
+	struct mt7987_2p5ge_phy_priv *priv;
+	struct pinctrl_state *led_state;
+	struct pinctrl *pinctrl;
+	int ret;
+
+	priv = devm_kzalloc(&phydev->mdio.dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	/* Cache the handle and state once; config_init selects after polarity. */
+	pinctrl = devm_pinctrl_get(&phydev->mdio.dev);
+	if (IS_ERR(pinctrl)) {
+		ret = PTR_ERR(pinctrl);
