Subject: [PATCH] net: pcs: mtk-lynxi: support MT7987 PHYA TRX clock

Port the PHYA TRX reference-clock and SGMII buffer settings from the
existing MT7987 downstream support while retaining the Linux 6.18 PCS
library API and unchanged behaviour for unflagged hardware.

Base: Linux 6.18.51 (f6388029ea9e2c9e807d73827658738ea131faee).
Derived from the existing E87N Linux 6.12 MT7987 patches and their
required SGMII routing support. No hardware validation is claimed.

---
diff --git a/drivers/net/pcs/pcs-mtk-lynxi.c b/drivers/net/pcs/pcs-mtk-lynxi.c
--- a/drivers/net/pcs/pcs-mtk-lynxi.c
+++ b/drivers/net/pcs/pcs-mtk-lynxi.c
@@ -19,6 +19,7 @@
 #define SGMSYS_PCS_CONTROL_1		0x0
 #define SGMII_BMCR			GENMASK(15, 0)
 #define SGMII_BMSR			GENMASK(31, 16)
+#define SGMII_REF_CK_SEL		BIT(24)
 
 #define SGMSYS_PCS_DEVICE_ID		0x4
 #define SGMII_LYNXI_DEV_ID		0x4d544950
@@ -46,6 +47,7 @@
 #define SGMII_SPEED_1000		FIELD_PREP(SGMII_SPEED_MASK, 2)
 #define SGMII_DUPLEX_HALF		BIT(4)
 #define SGMII_REMOTE_FAULT_DIS		BIT(8)
+#define SGMII_TRXBUF_THR_MASK		GENMASK(31, 16)
 
 /* Register to reset SGMII design */
 #define SGMSYS_RESERVED_0		0x34
@@ -125,8 +127,8 @@
 {
 	struct mtk_pcs_lynxi *mpcs = pcs_to_mtk_pcs_lynxi(pcs);
 	bool mode_changed = false, changed;
-	unsigned int rgc3, sgm_mode, bmcr;
-	int advertise, link_timer;
+	unsigned int rgc3, sgm_mode, bmcr, sgm_mask, bmcr_mask;
+	int advertise, link_timer, ret;
 
 	advertise = phylink_mii_c22_pcs_encode_advertisement(interface,
 							     advertising);
@@ -193,13 +195,27 @@
 				 SGMII_ADVERTISE, advertise, &changed);
 
 	/* Update the sgmsys mode register */
-	regmap_update_bits(mpcs->regmap, SGMSYS_SGMII_MODE,
-			   SGMII_REMOTE_FAULT_DIS | SGMII_SPEED_DUPLEX_AN |
-			   SGMII_IF_MODE_SGMII, sgm_mode);
+	sgm_mask = SGMII_REMOTE_FAULT_DIS | SGMII_SPEED_DUPLEX_AN |
+		   SGMII_IF_MODE_SGMII;
+	bmcr_mask = BMCR_ANENABLE;
+	if (mpcs->flags & MTK_SGMII_FLAG_PHYA_TRX_CK) {
+		/* NETSYS v3.1 uses the integrated PHYA TX/RX clock path. */
+		sgm_mask |= SGMII_TRXBUF_THR_MASK;
+		sgm_mode |= FIELD_PREP(SGMII_TRXBUF_THR_MASK, 0x2111);
+		bmcr_mask |= SGMII_REF_CK_SEL;
+		bmcr |= SGMII_REF_CK_SEL;
+	}
 
+	ret = regmap_update_bits(mpcs->regmap, SGMSYS_SGMII_MODE,
+				 sgm_mask, sgm_mode);
+	if (ret)
+		return ret;
+
 	/* Update the BMCR */
-	regmap_update_bits(mpcs->regmap, SGMSYS_PCS_CONTROL_1,
-			   BMCR_ANENABLE, bmcr);
+	ret = regmap_update_bits(mpcs->regmap, SGMSYS_PCS_CONTROL_1,
+				 bmcr_mask, bmcr);
+	if (ret)
+		return ret;
 
 	/* Release PHYA power down state
 	 * Only removing bit SGMII_PHYA_PWD isn't enough.
diff --git a/include/linux/pcs/pcs-mtk-lynxi.h b/include/linux/pcs/pcs-mtk-lynxi.h
--- a/include/linux/pcs/pcs-mtk-lynxi.h
+++ b/include/linux/pcs/pcs-mtk-lynxi.h
@@ -6,6 +6,7 @@
 #include <linux/regmap.h>
 
 #define MTK_SGMII_FLAG_PN_SWAP BIT(0)
+#define MTK_SGMII_FLAG_PHYA_TRX_CK BIT(2)
 struct phylink_pcs *mtk_pcs_lynxi_create(struct device *dev,
 					 struct regmap *regmap,
 					 u32 ana_rgc3, u32 flags);
