+static int lvts_validate_polling(struct device *dev, const struct lvts_data *lvts_data)
+{
+	struct device_node *zones __free(device_node) =
+		of_find_node_by_path("/thermal-zones");
+	bool found = false;
+
+	if (!zones)
+		return dev_err_probe(dev, -ENODEV, "Polling requires a thermal zone\n");
+
+	for_each_available_child_of_node_scoped(zones, zone) {
+		struct of_phandle_args sensor;
+		u32 delay, passive_delay;
+		bool matches, valid_sensor = false;
+		int i, j, ret;
+
+		ret = of_parse_phandle_with_args(zone, "thermal-sensors",
+						 "#thermal-sensor-cells", 0, &sensor);
+		if (ret)
+			continue;
+
+		matches = sensor.np == dev_of_node(dev);
+		of_node_put(sensor.np);
+		if (!matches)
+			continue;
+
+		if (sensor.args_count != 1)
+			return dev_err_probe(dev, -EINVAL, "%pOF requires one sensor ID\n", zone);
+
+		for (i = 0; i < lvts_data->num_lvts_ctrl; i++) {
+			const struct lvts_ctrl_data *ctrl = &lvts_data->lvts_ctrl[i];
+
+			lvts_for_each_valid_sensor(j, ctrl)
+				if (ctrl->lvts_sensor[j].dt_id == sensor.args[0])
+					valid_sensor = true;
+		}
+		if (!valid_sensor)
+			return dev_err_probe(dev, -EINVAL, "%pOF has an invalid sensor ID\n", zone);
+
+		if (of_property_read_u32(zone, "polling-delay", &delay) || !delay ||
+		    of_property_read_u32(zone, "polling-delay-passive", &passive_delay) ||
+		    !passive_delay)
+			return dev_err_probe(dev, -EINVAL,
+					     "%pOF requires nonzero polling delays\n", zone);
+
+		found = true;
+	}
+
+	if (!found)
+		return dev_err_probe(dev, -ENODEV, "Polling requires a matching thermal zone\n");
+
+	return 0;
 }
 
 static int lvts_probe(struct platform_device *pdev)
@@ -1312,7 +1392,7 @@
