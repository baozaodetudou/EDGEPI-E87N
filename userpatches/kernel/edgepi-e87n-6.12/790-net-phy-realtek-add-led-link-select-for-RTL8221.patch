From: Yangyu Chen <cyy@cyyself.name>
Date: Sun, 23 Apr 2023 20:06:41 +0800
Subject: [PATCH] net: phy: realtek: add led-link-select for RTL8221

Allow boards to override the three link LED registers, activity and
polarity through firmware properties.

Adapt to BPI-Router-Linux b864732ee285e7868fb0857d69a8ff349e37003e
(Linux 6.12.108), whose driver is drivers/net/phy/realtek.c and keeps
the SerDes sequence inside rtl822xb_config_init(). Preserve that
sequence in rtl822xb_config_serdes(), then configure LEDs only after
it succeeds, including its no-interface-change success path.
Keep the existing C22/C45 config_init callbacks and propagate MDIO
errors. Boards without LED properties do not write LED registers.

Signed-off-by: Yangyu Chen <cyy@cyyself.name>
---
--- a/drivers/net/phy/realtek.c
+++ b/drivers/net/phy/realtek.c
@@ -10,6 +10,7 @@
 #include <linux/bitops.h>
 #include <linux/of.h>
 #include <linux/phy.h>
+#include <linux/property.h>
 #include <linux/module.h>
 #include <linux/delay.h>
 #include <linux/clk.h>
@@ -99,6 +100,12 @@
 
 #define RTL8211F_LED_COUNT			3
 
+#define RTL8221B_NR_LEDS				3
+#define RTL8221B_LED_LINK_SELECT			0xd032
+#define RTL8221B_LED_LINK_SELECT_OFFSET		0x2
+#define RTL8221B_LED_ACT_SELECT			0xd040
+#define RTL8221B_LED_POLARITY_SELECT		0xd044
+
 MODULE_DESCRIPTION("Realtek PHY driver");
 MODULE_AUTHOR("Johnson Leung");
 MODULE_LICENSE("GPL");
@@ -787,7 +794,7 @@
 	return ret;
 }
 
-static int rtl822xb_config_init(struct phy_device *phydev)
+static int rtl822xb_config_serdes(struct phy_device *phydev)
 {
 	bool has_2500, has_sgmii;
 	u16 mode;
@@ -842,6 +849,59 @@
 		return ret;
 
 	return phy_write_mmd(phydev, MDIO_MMD_VEND1, 0x6f11, 0x8020);
+}
+
+static int rtl8221b_config_led(struct phy_device *phydev)
+{
+	struct device *dev = &phydev->mdio.dev;
+	u32 link_select[RTL8221B_NR_LEDS];
+	u32 act_select, polarity_select;
+	int i, ret;
+
+	ret = device_property_read_u32_array(dev, "realtek,led-link-select",
+					     link_select, RTL8221B_NR_LEDS);
+	if (!ret) {
+		for (i = 0; i < RTL8221B_NR_LEDS; i++) {
+			ret = phy_write_mmd(phydev, MDIO_MMD_VEND2,
+					    RTL8221B_LED_LINK_SELECT +
+					    i * RTL8221B_LED_LINK_SELECT_OFFSET,
+					    link_select[i]);
+			if (ret < 0)
+				return ret;
+		}
+	}
+
+	ret = device_property_read_u32(dev, "realtek,led-act-select",
+				       &act_select);
+	if (!ret) {
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND2,
+				    RTL8221B_LED_ACT_SELECT, act_select);
+		if (ret < 0)
+			return ret;
+	}
+
+	ret = device_property_read_u32(dev, "realtek,led-polarity-select",
+				       &polarity_select);
+	if (!ret) {
+		ret = phy_write_mmd(phydev, MDIO_MMD_VEND2,
+				    RTL8221B_LED_POLARITY_SELECT,
+				    polarity_select);
+		if (ret < 0)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int rtl822xb_config_init(struct phy_device *phydev)
+{
+	int ret;
+
+	ret = rtl822xb_config_serdes(phydev);
+	if (ret < 0)
+		return ret;
+
+	return rtl8221b_config_led(phydev);
 }
 
 static int rtl822xb_get_rate_matching(struct phy_device *phydev,
